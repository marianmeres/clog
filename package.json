{
  "name": "@marianmeres/clog",
  "version": "3.23.0",
  "description": "Universal console-compatible logger with namespaces, structured JSON output, colors, log forwarding and a web-app preset, for browser and server.",
  "license": "MIT",
  "author": "Marian Meres",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=24.12"
  },
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "main": "./dist/mod.js",
  "types": "./dist/mod.d.ts",
  "exports": {
    ".": {
      "types": "./dist/mod.d.ts",
      "default": "./dist/mod.js"
    },
    "./forward": {
      "types": "./dist/forward.d.ts",
      "default": "./dist/forward.js"
    },
    "./web": {
      "types": "./dist/web.d.ts",
      "default": "./dist/web.js"
    }
  },
  "files": [
    "dist",
    "API.md",
    "AGENTS.md"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/marianmeres/clog.git"
  },
  "bugs": {
    "url": "https://github.com/marianmeres/clog/issues"
  },
  "homepage": "https://github.com/marianmeres/clog#readme",
  "keywords": [
    "logger",
    "log",
    "console",
    "namespace",
    "json",
    "structured-logging",
    "browser"
  ],
  "scripts": {
    "build": "pnpm run clean && tsc -p tsconfig.build.json",
    "clean": "rm -rf dist",
    "typecheck": "tsc --noEmit",
    "lint": "biome check .",
    "format": "biome check --write .",
    "test": "node --test \"tests/**/*.test.ts\"",
    "test:watch": "node --test --watch \"tests/**/*.test.ts\"",
    "test:deno": "deno test --no-check --no-lock --config jsr.json tests/",
    "ci": "pnpm run typecheck && pnpm run lint && pnpm test",
    "prepublishOnly": "pnpm run ci && pnpm run build",
    "release": "npx --yes @marianmeres/release@^2.2.0",
    "publish:jsr": "pnpm run test:deno && deno publish --set-version \"$npm_package_version\"",
    "publish:all": "pnpm publish && pnpm run publish:jsr",
    "rp": "pnpm run release -y && pnpm run publish:all",
    "rpm": "pnpm run release minor -y && pnpm run publish:all"
  },
  "peerDependencies": {
    "@marianmeres/batch": "^1.3.0"
  },
  "peerDependenciesMeta": {
    "@marianmeres/batch": {
      "optional": true
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.3",
    "@marianmeres/batch": "^1.3.0",
    "@types/node": "^26.6.5",
    "typescript": "^7.0.2"
  }
}
