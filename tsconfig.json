{
	// Editor + `pnpm run typecheck` view: src and tests, no output. Node runs the
	// source with its types stripped and never checks them, so this is the type gate.
	"compilerOptions": {
		"target": "es2024",
		// "dom": clog also runs in the browser (window, document, localStorage)
		"lib": ["es2024", "dom"],
		"module": "nodenext",
		"moduleResolution": "nodenext",
		"types": ["node"],

		"strict": true,
		"noUncheckedIndexedAccess": true,
		"noImplicitOverride": true,
		"noFallthroughCasesInSwitch": true,
		"skipLibCheck": true,

		// erasable-only TS: what Node's type stripping can run unchanged
		"verbatimModuleSyntax": true,
		"erasableSyntaxOnly": true,
		// imports keep their `.ts` extension in source; tsc rewrites them to `.js` on emit
		"allowImportingTsExtensions": true,
		"rewriteRelativeImportExtensions": true,

		"noEmit": true
	},
	"include": ["src", "tests", "examples"]
}
